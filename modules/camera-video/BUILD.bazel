# FP6 phase 5 vendor modules (camera-video) as DDK modules against the FP6 device kernel build. Sources
# and their origin: fp6/sources.tsv. Generated from modules.bzl (scripts gen_ddk.py). The headers
# that core-headers.json names are 6.18's own, kept identical. The base layer comes from
# modules/base.

load("//build/kernel/kleaf:kernel.bzl", "ddk_config", "ddk_headers", "ddk_module")

package(default_visibility = ["//visibility:public"])

ddk_config(
    name = "config",
    defconfig = "defconfig",
    kconfigs = ["Kconfig"],
    kernel_build = "//devices/fairphone/fp6/kernel:fp6_aarch64",
    deps = [
        "//devices/fairphone/fp6/modules/base:config",
        "//devices/fairphone/fp6/modules/audio-sensors:config",
    ],
)

ddk_headers(
    name = "headers",
    hdrs = glob([
        "camera-kernel/**/*.h",
        "drivers/**/*.h",
        "include/**/*.h",
        "mm-drivers/**/*.h",
        "securemsm-kernel/**/*.h",
        "synx-kernel/**/*.h",
        "video-driver/**/*.h",
    ]),
    includes = ["."],
    # Before the kernel's own include directories, as Qualcomm's DDK headers do.
    linux_includes = [
        "include",
        "camera-kernel/drivers/cam_cpas/include",
        "camera-kernel/drivers/cam_cre/cam_cre_hw_mgr/cre_hw/include",
        "camera-kernel/drivers/cam_cust/cam_custom_hw_mgr/include",
        "camera-kernel/drivers/cam_icp/icp_hw/icp_hw_mgr/include",
        "camera-kernel/drivers/cam_icp/icp_hw/include",
        "camera-kernel/drivers/cam_isp/isp_hw_mgr/hw_utils/include",
        "camera-kernel/drivers/cam_isp/isp_hw_mgr/include",
        "camera-kernel/drivers/cam_isp/isp_hw_mgr/isp_hw/include",
        "camera-kernel/drivers/cam_isp/isp_hw_mgr/isp_hw/sfe_hw/sfe_bus/include",
        "camera-kernel/drivers/cam_isp/isp_hw_mgr/isp_hw/vfe_hw/vfe_bus/include",
        "camera-kernel/drivers/cam_isp/isp_hw_mgr/isp_hw/vfe_hw/vfe_top/include",
        "camera-kernel/drivers/cam_jpeg/jpeg_hw/include",
        "camera-kernel/drivers/cam_sensor_module/cam_csiphy/include",
        "camera-kernel/include/uapi/camera",
        "camera-kernel/include/uapi/camera/media",
        "securemsm-kernel/include",
        "securemsm-kernel/include/linux",
        "securemsm-kernel/include/uapi/linux",
        "synx-kernel/include/uapi/synx",
        "synx-kernel/include/uapi/synx/media",
        "video-driver/include/uapi/vidc",
