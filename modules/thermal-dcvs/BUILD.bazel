# FP6 phase 5 vendor modules (thermal-dcvs) as DDK modules against the FP6 device kernel build. Sources
# and their origin: fp6/sources.tsv. Generated from modules.bzl (scripts gen_ddk.py). The headers
# that core-headers.json names are 6.18's own, kept identical. The base layer comes from
# modules/base.

load("//build/kernel/kleaf:kernel.bzl", "ddk_config", "ddk_headers", "ddk_module")

package(default_visibility = ["//visibility:public"])

ddk_config(
    name = "config",
    defconfig = "defconfig",
    kconfigs = ["Kconfig"],
    kernel_build = "//devices/fairphone/fp6/kernel:fp6_aarch64",
    deps = [
        "//devices/fairphone/fp6/modules/base:config",
    ],
)

ddk_headers(
    name = "headers",
    hdrs = glob([
        "drivers/**/*.h",
        "include/**/*.h",
    ]),
    includes = ["."],
    # Before the kernel's own include directories, as Qualcomm's DDK headers do.
    linux_includes = [
        "include",
    ],
)

