# DiamaneOS hardening for the FP6 on 6.18, for every profile.
# From the DiamaneOS changes to gki_defconfig on kernel_common-6.1 and
# config/kernel-policy-fp6.json in diamaneos-tools, where they still apply.
# Not carried, with the reason:
#   CONFIG_CFI_CLANG is CONFIG_CFI since 6.18.
#   CONFIG_CRYPTO_SHA1_ARM64_CE is gone: SHA-1 is part of the crypto library.
#   CONFIG_DEBUG_CREDENTIALS is gone since 6.7.
#   Lockdown confidentiality: 6.18 uses integrity (production) or none (bring-up).
#   CONFIG_RANDSTRUCT_FULL: 6.18 builds Rust only without RANDSTRUCT, and it uses Rust
#   and the Rust binder as GrapheneOS 17 does (decided 2026-10-29), built in with no C binder
#   as GrapheneOS 17 builds it since def292d9e.
# CONFIG_POSIX_MQUEUE is not set
# CONFIG_ARCH_TEGRA is not set
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_VA_BITS=48
# CONFIG_ARM64_PMEM is not set
CONFIG_ARM64_BTI_KERNEL=y
# CONFIG_UNWIND_PATCH_PAC_INTO_SCS is not set
# CONFIG_HIBERNATION is not set
CONFIG_ARCH_MMAP_RND_BITS=33
CONFIG_ARCH_MMAP_RND_COMPAT_BITS=16
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_CFI=y
# CONFIG_CFI_PERMISSIVE is not set
CONFIG_SHADOW_CALL_STACK=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_RANDSTRUCT_NONE=y
CONFIG_RUST=y
# CONFIG_ANDROID_BINDER_IPC is not set
CONFIG_ANDROID_BINDER_IPC_RUST=y
CONFIG_MODULES=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_SHA256=y
# CONFIG_MODULE_SIG_PROTECT is not set
# CONFIG_MODULE_FORCE_LOAD is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_ZONE_DEVICE is not set
CONFIG_RESET_ATTACK_MITIGATION=y
CONFIG_EFI_DISABLE_PCI_DMA=y
# CONFIG_LDISC_AUTOLOAD is not set
# CONFIG_SERIAL_TEGRA_TCU is not set
CONFIG_MAILBOX=y
# CONFIG_MEMORY is not set
CONFIG_GENERIC_PHY=y
CONFIG_INTERCONNECT=y
# CONFIG_DEVMEM is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_KGDB is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
# CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY is not set
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x0
# CONFIG_MAGIC_SYSRQ_SERIAL is not set
CONFIG_DEBUG_SG=y
CONFIG_PAGE_TABLE_CHECK=y
CONFIG_PAGE_TABLE_CHECK_ENFORCED=y
CONFIG_USERFAULTFD=y
CONFIG_IO_URING=y
CONFIG_UNICODE=y
CONFIG_F2FS_FS=y
CONFIG_KPROBES=y
CONFIG_KRETPROBES=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_DEBUG_FS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
