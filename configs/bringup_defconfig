# Bring-up debug profile: everything that helps debugging, while 6.18 is brought up.
# SELinux and module signature enforcement stay as in production.
CONFIG_DEBUG_FS_ALLOW_ALL=y
# CONFIG_DEBUG_FS_DISALLOW_MOUNT is not set
# CONFIG_DEBUG_FS_ALLOW_NONE is not set
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y
CONFIG_HW_PERF_EVENTS=y
CONFIG_DYNAMIC_DEBUG=y
# CONFIG_SECURITY_DMESG_RESTRICT is not set
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_PSTORE_FTRACE=y
CONFIG_KFENCE=y
CONFIG_UBSAN=y
# UBSAN reports instead of trapping: the vendor code is still being fixed
# CONFIG_UBSAN_TRAP is not set
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_RCU_CPU_STALL_TIMEOUT=21
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_NONE=y
# CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY is not set
# Crash settings: an oops, a lockup or a hung task panics, and the phone restarts 5 s
# after a panic with the log in pstore. The packaging adds sysctl.kernel.panic_on_rcu_stall=1.
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=5
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
# Stop at a TLB sync timeout to keep the state. Never in production, the kernel policy refuses it.
CONFIG_IOMMU_TLBSYNC_DEBUG=y
