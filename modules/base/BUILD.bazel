# FP6 boot base layer as DDK modules against the 6.18 GKI kernel. Sources and their origin:
# fp6/sources.tsv. The modules.bzl registry is the source of this file (scripts gen_ddk.py).
# The headers under drivers/ and kernel/ that core-headers.json names are 6.18's own, kept identical.

load("//build/kernel/kleaf:kernel.bzl", "ddk_config", "ddk_headers", "ddk_module")

package(default_visibility = ["//visibility:public"])

ddk_config(
    name = "config",
    defconfig = "defconfig",
    kconfigs = ["Kconfig"],
    kernel_build = "//devices/fairphone/fp6/kernel:fp6_aarch64",
)

ddk_headers(
    name = "headers",
    hdrs = glob([
        "arch/**/*.h",
        "include/**/*.h",
        "drivers/**/*.h",
        "kernel/**/*.h",
        "net/**/*.h",
        "vendor/**/*.h",
    ]),
    includes = ["."],
    # Before the kernel's own include directories, as Qualcomm's DDK headers do.
    linux_includes = [
        "arch/arm64/include",
        "include",
        "include/uapi",
    ],
)

ddk_module(
    name = "qcom_ipc_logging",
    out = "qcom_ipc_logging.ko",
    srcs = [
        "kernel/trace/ipc_logging.c",
        "kernel/trace/ipc_logging_debug.c",
        "kernel/trace/ipc_logging_private.h",
    ],
    conditional_srcs = {
        "CONFIG_IPC_LOGGING_CDEV": {
            True: [
                "kernel/trace/ipc_logging_cdev.c",
            ],
        },
    },
    includes = [
        "kernel/trace",
    ],
    config = ":config",
    kernel_build = "//devices/fairphone/fp6/kernel:fp6_aarch64",
    deps = [
        ":headers",
        ":minidump",
    ],
)

